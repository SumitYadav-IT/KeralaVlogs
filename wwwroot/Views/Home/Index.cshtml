@{
    ViewData["Title"] = "Kerla Vlog";
}

<div class="hero-section">
    <div class="hero-content">
        <h1>My Kerala Journey</h1>

        <p>
            Seven days. Beautiful places.
            Unforgettable memories.
        </p>

        <a href="/Journey" class="btn btn-primary">
            Explore My Journey
        </a>
    </div>
</div>

<section class="container mt-5">

    <div class="text-center">
        <h2>Welcome to My Kerala Vlog</h2>

        <p>
            Join me as I share my journey through the beautiful
            landscapes, beaches, backwaters and hills of Kerala.
        </p>
    </div>

    <div class="row mt-4">

        <div class="col-md-4">
            <div class="card p-3">
                <h3>📍 Places</h3>
                <p>
                    Explore the beautiful destinations I visited
                    during my Kerala trip.
                </p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card p-3">
                <h3>📸 Memories</h3>
                <p>
                    Browse through photographs and unforgettable
                    moments from my journey.
                </p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card p-3">
                <h3>🎥 Videos</h3>
                <p>
                    Watch videos and relive the experience of
                    travelling through Kerala.
                </p>
            </div>
        </div>

    </div>

</section>