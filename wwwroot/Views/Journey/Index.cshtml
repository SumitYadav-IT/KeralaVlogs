@{
    ViewData["Title"] = "My Journey";
}

<div class="container mt-5">

    <div class="text-center mb-5">
        <h1>My Kerala Journey</h1>

        <p class="lead">
            A journey through the beautiful landscapes of Kerala.
        </p>
    </div>

    <div class="row g-4">

        <div class="col-md-4">
            <div class="card destination-card">

                <img src="/images/munnar.jpeg"
                     class="card-img-top"
                     alt="Munnar">

                <div class="card-body">
                    <h3>Munnar</h3>

                    <p>
                        Beautiful tea gardens, mountains,
                        waterfalls and amazing views.
                    </p>

                    <a href="#" class="btn btn-primary">
                        Explore
                    </a>
                </div>

            </div>
        </div>


        <div class="col-md-4">
            <div class="card destination-card">

                <img src="/images/alleppey.jpeg"
                     class="card-img-top"
                     alt="Alleppey">

                <div class="card-body">
                    <h3>Alleppey</h3>

                    <p>
                        Famous for its beautiful backwaters,
                        houseboats and peaceful atmosphere.
                    </p>

                    <a href="#" class="btn btn-primary">
                        Explore
                    </a>
                </div>

            </div>
        </div>


        <div class="col-md-4">
            <div class="card destination-card">

                <img src="/images/varkala.jpeg"
                     class="card-img-top"
                     alt="Varkala">

                <div class="card-body">
                    <h3>Varkala</h3>

                    <p>
                        Beautiful beaches, cliffs and
                        unforgettable sunsets.
                    </p>

                    <a href="#" class="btn btn-primary">
                        Explore
                    </a>
                </div>

            </div>
        </div>

    </div>

</div>