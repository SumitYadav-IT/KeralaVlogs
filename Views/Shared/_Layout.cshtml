<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - KerlaVlogs</title>

    <script type="importmap"></script>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/KerlaVlogs.styles.css"
          asp-append-version="true" />
</head>

<body>

    <!-- ================= NAVBAR ================= -->

    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark">

            <div class="container">

                <!-- LOGO -->
                <a class="navbar-brand fw-bold"
                   asp-controller="Home"
                   asp-action="Index">
                    🌴 Kerala Vlog
                </a>


                <!-- MOBILE MENU BUTTON -->
                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#navbarNav">

                    <span class="navbar-toggler-icon"></span>

                </button>


                <!-- NAVIGATION -->
                <div class="collapse navbar-collapse"
                     id="navbarNav">

                    <ul class="navbar-nav ms-auto">

                        <!-- JOURNEY -->

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Journey"
                               asp-action="Index">

                                🌴 Journey

                            </a>

                        </li>


                        <!-- ITINERARY -->
                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Journey"
                               asp-action="Itinerary">

                                🗓️ Itinerary

                            </a>

                        </li>


                        <!-- GALLERY -->
                           
                        <li class="nav-item">
    <a class="nav-link"
       asp-controller="Home"
       asp-action="Index">
        🏠 Home
    </a>
</li>

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Gallery"
                               asp-action="Index">

                                📸 Gallery

                            </a>

                        </li>


                        <!-- ADMIN / LOGIN -->
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <!-- ADMIN DASHBOARD -->

                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="Admin"
                                   asp-action="Index">

                                    ⚙️ Admin

                                </a>

                            </li>


                            <!-- LOGOUT -->

                            <li class="nav-item">

                                <form asp-controller="Account"
                                      asp-action="Logout"
                                      method="post"
                                      class="d-inline">

                                    <button type="submit"
                                            class="nav-link nav-logout">

                                        🚪 Logout

                                    </button>

                                </form>

                            </li>
                        }
                        else
                        {
                            <!-- ADMIN LOGIN -->

                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="Account"
                                   asp-action="Login">

                                    🔐 Admin Login

                                </a>

                            </li>
                        }

                    </ul>

                </div>

            </div>

        </nav>
    </header>


    <!-- ================= MAIN CONTENT ================= -->

    <div class="container">

        <main role="main" class="pb-3">

            @RenderBody()

        </main>

    </div>


    <!-- ================= FOOTER ================= -->

    <footer class="border-top footer text-muted">

        <div class="container">

            &copy; 2026 - KerlaVlogs -

            <a asp-area=""
               asp-controller="Home"
               asp-action="Privacy">

                Privacy

            </a>

        </div>

    </footer>


    <!-- ================= SCRIPTS ================= -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>