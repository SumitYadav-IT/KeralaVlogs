@model KerlaVlogs.Models.Destination

@{
    ViewData["Title"] = "Delete Destination";
}

<div class="container mt-5">

    <div class="card">

        <div class="card-body">

            <h1 class="text-danger">
                Delete Destination
            </h1>

            <p class="mt-3">
                Are you sure you want to delete this destination?
            </p>

            <h3>@Model.Name</h3>

            <p>
                @Model.Location
            </p>

            <form asp-action="Delete"
                  method="post">

                <input type="hidden"
                       asp-for="Id" />

                <button type="submit"
                        class="btn btn-danger">

                    Yes, Delete

                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">

                    Cancel

                </a>

            </form>

        </div>

    </div>

</div>